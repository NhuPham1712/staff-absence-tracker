<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bảng điều khiển - Present Portal</title>
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        /* Reset & premium fonts */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #e5e5ea; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #c1c1c4; }

        body {
            background-color: #faf9f5;
            font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            color: #1d1d1f;
            overflow-x: hidden;
        }

        .text-orange { color: #8c7b45 !important; }
        .bg-orange { background-color: #F3E6B3 !important; }
        
        .btn-orange {
            background: linear-gradient(135deg, #F3E6B3 0%, #e2d39d 100%);
            color: #3d3516;
            border: none;
            font-weight: 600;
            padding: 12px 24px;
            border-radius: 14px;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 4px 12px rgba(243, 230, 179, 0.3);
        }
        
        .btn-orange:hover {
            background: linear-gradient(135deg, #e2d39d 0%, #d1c18c 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(243, 230, 179, 0.5);
            color: #241f0b;
        }

        .wrapper { display: flex; width: 100%; align-items: stretch; }

        /* Premium Sidebar */
        #sidebar {
            min-width: 270px;
            max-width: 270px;
            background: #ffffff;
            min-height: 100vh;
            border-right: 1px solid rgba(0,0,0,0.04);
            display: flex;
            flex-direction: column;
            position: fixed;
            box-shadow: 4px 0 24px rgba(140, 123, 69, 0.02);
            z-index: 10;
        }
        
        .sidebar-header { padding: 32px 24px 20px 24px; }
        
        .nav-link {
            color: #515154;
            padding: 12px 20px;
            font-weight: 500;
            border-radius: 14px;
            margin: 4px 16px;
            transition: all 0.25s ease;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
        }
        
        .nav-link i { margin-right: 12px; font-size: 1.2rem; width: 24px; text-align: center; }
        .nav-link:hover { background: rgba(243, 230, 179, 0.12); color: #8c7b45; }
        
        .nav-link.active {
            background: linear-gradient(135deg, #F3E6B3 0%, #e2d39d 100%);
            color: #3d3516;
            box-shadow: 0 6px 15px rgba(243, 230, 179, 0.35);
            font-weight: 600;
        }
        
        .sidebar-heading {
            font-size: 0.7rem;
            letter-spacing: 0.8px;
            font-weight: 700;
            color: #9e9e9f;
            padding-left: 24px;
            margin-top: 24px;
            margin-bottom: 8px;
            text-transform: uppercase;
        }
        
        .sidebar-footer {
            margin-top: auto;
            padding: 24px;
            border-top: 1px solid rgba(0,0,0,0.04);
        }

        /* Main content styling */
        #content {
            width: calc(100% - 270px);
            margin-left: 270px;
            padding: 40px 50px;
        }

        /* Stat cards with micro-interactions */
        .stat-card {
            background: white;
            border-radius: 24px;
            border: 1px solid rgba(140, 123, 69, 0.06);
            padding: 1.8rem;
            box-shadow: 0 8px 24px rgba(140, 123, 69, 0.02);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 32px rgba(140, 123, 69, 0.08);
            border-color: rgba(243, 230, 179, 0.5);
        }
        
        .stat-icon {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 2.2rem;
            color: #F3E6B3;
            opacity: 0.6;
        }
        
        .stat-title {
            font-size: 0.75rem;
            font-weight: 700;
            color: #86868b;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            margin-bottom: 12px;
        }
        
        .stat-value { 
            font-size: 2.6rem; 
            font-weight: 750; 
            line-height: 1.1; 
            letter-spacing: -0.03em;
            color: #1d1d1f;
        }

        /* Tables & Cards */
        .premium-card {
            background: #ffffff;
            border-radius: 24px;
            border: 1px solid rgba(140, 123, 69, 0.04);
            box-shadow: 0 10px 30px rgba(140, 123, 69, 0.02);
            overflow: hidden;
        }
        
        .table-custom { margin-bottom: 0; }
        .table-custom thead th {
            border-bottom: 1px solid rgba(0,0,0,0.04);
            color: #86868b;
            font-size: 0.75rem;
            text-transform: uppercase;
            font-weight: 600;
            padding: 18px 24px;
            letter-spacing: 0.5px;
        }
        .table-custom tbody td {
            border-bottom: 1px solid rgba(0,0,0,0.02);
            padding: 18px 24px;
            vertical-align: middle;
        }
        .table-custom tbody tr:hover {
            background-color: rgba(243, 230, 179, 0.03);
        }
        .table-custom tbody tr:last-child td {
            border-bottom: none;
        }
        
        /* Badges */
        .badge-soft {
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 40px;
            font-size: 0.8rem;
            display: inline-flex;
            align-items: center;
        }
        
        .badge-soft-warning {
            background-color: #fff8eb;
            color: #b25e00;
            border: 1px solid rgba(255, 149, 0, 0.15);
        }
        
        .badge-soft-success {
            background-color: #f2fcf5;
            color: #1e7b3c;
            border: 1px solid rgba(52, 199, 89, 0.15);
        }

        @media (max-width: 992px) {
            #sidebar { transform: translateX(-100%); position: fixed; }
            #content { width: 100%; margin-left: 0; padding: 30px 20px; }
        }
    </style>
</head>
<body>
<div class="wrapper">
    <!-- Sidebar -->
    <nav id="sidebar">
        <div class="sidebar-header d-flex align-items-center mb-2">
            <div class="bg-orange rounded-3 p-2 me-3 shadow-sm" style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-buildings text-dark fs-5"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-bold" style="letter-spacing: -0.3px;">Present</h5>
                <small class="text-muted fw-medium" style="font-size: 0.7rem;">Hệ thống Nhân sự</small>
            </div>
        </div>

        <ul class="nav flex-column mt-2">
            <li class="nav-item"><a href="/dashboard" class="nav-link active"><i class="bi bi-grid-1x2-fill"></i> Tổng quan</a></li>
            <div class="sidebar-heading">CÁ NHÂN</div>
            <li class="nav-item"><a href="/bang-luong" class="nav-link"><i class="bi bi-cash-stack"></i> Phiếu lương</a></li>
            <div class="sidebar-heading">QUẢN LÝ ĐƠN TỪ</div>
            <li class="nav-item"><a href="/tao-don" class="nav-link"><i class="bi bi-pencil-square"></i> Tạo đơn xin nghỉ</a></li>
            <li class="nav-item"><a href="/lich-su-nghi" class="nav-link"><i class="bi bi-clock-history"></i> Lịch sử đơn từ</a></li>

            <% if (user.ma_chuc_vu === 1 || user.ma_chuc_vu === 2) { %>
                <div class="sidebar-heading">QUẢN TRỊ VIÊN</div>
                <li class="nav-item"><a href="/duyet-don" class="nav-link"><i class="bi bi-check2-square"></i> Duyệt đơn 
                    <% if (typeof soDonChoDuyet !== 'undefined' && soDonChoDuyet > 0) { %>
                        <span class="badge bg-danger ms-2 rounded-pill"><%= soDonChoDuyet %></span>
                    <% } %>
                </a></li>
                <li class="nav-item"><a href="/quan-ly-nhan-su" class="nav-link"><i class="bi bi-people-fill"></i> Hồ sơ Nhân sự</a></li>
            <% } %>
        </ul>

        <div class="sidebar-footer">
            <div class="d-flex align-items-center mb-3 px-2">
                <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.ho_ten) %>&background=F3E6B3&color=1d1d1f&bold=true&rounded=true&size=42" width="42" height="42" class="me-3 shadow-sm rounded-circle">
                <div>
                    <h6 class="mb-0 fw-bold"><%= user.ho_ten %></h6>
                    <small class="text-muted d-block text-truncate" style="max-width: 150px; font-size: 0.8rem;"><%= user.email %></small>
                    <% if (user.ma_chuc_vu === 1) { %><div><span class="badge bg-orange bg-opacity-10 text-orange px-2 mt-1" style="font-size: 9px; color: #8c7b45 !important;">Quản trị viên</span></div><% } %>
                    <% if (user.ma_chuc_vu === 2) { %><div><span class="badge bg-orange bg-opacity-10 text-orange px-2 mt-1" style="font-size: 9px; color: #8c7b45 !important;">Quản lý</span></div><% } %>
                </div>
            </div>
            <a href="/dang-xuat" class="btn btn-light w-100 fw-semibold" style="color: #ff3b30; border-radius: 14px; background: #fff5f5; border: none; padding: 10px;"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
        </div>
    </nav>

    <!-- Main Content -->
    <div id="content">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-5">
            <div>
                <h2 class="fw-bold mb-1" style="letter-spacing: -0.8px;">Bảng điều khiển</h2>
                <p class="text-muted mb-0">Theo dõi quỹ phép và tình hình điều phối nhân sự hôm nay</p>
            </div>
            <a href="/tao-don" class="btn btn-orange mt-2 mt-sm-0 shadow-sm"><i class="bi bi-plus-lg me-2"></i>Tạo đơn mới</a>
        </div>

        <!-- Stat Cards -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-calendar-check stat-icon"></i>
                    <div class="stat-title">Quỹ phép năm nay</div>
                    <div class="stat-value text-primary" style="color: #705f2b !important;"><%= user.tong_ngay_phep %> <span class="fs-5 text-muted fw-medium">ngày</span></div>
                    <div class="mt-3 text-muted small"><i class="bi bi-info-circle me-1"></i>Cấp theo quy định</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-calendar-minus stat-icon" style="color: #ff3b30; opacity: 0.2;"></i>
                    <div class="stat-title">Đã sử dụng</div>
                    <div class="stat-value" style="color: #ff3b30;"><%= user.ngay_phep_da_dung %> <span class="fs-5 text-muted fw-medium">ngày</span></div>
                    <div class="mt-3 text-muted small"><i class="bi bi-calendar-minus me-1"></i>Đã trừ vào quỹ</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card" style="border-left: 4px solid #34c759;">
                    <i class="bi bi-shield-check stat-icon" style="color: #34c759; opacity: 0.2;"></i>
                    <div class="stat-title text-success">Còn lại có thể dùng</div>
                    <div class="stat-value text-success" style="color: #34c759 !important;"><%= user.tong_ngay_phep - user.ngay_phep_da_dung %> <span class="fs-5 text-muted fw-medium">ngày</span></div>
                    <div class="mt-3 text-success small"><i class="bi bi-check-circle me-1"></i>Khả dụng ngay</div>
                </div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="row g-4 mb-5">
            <div class="col-lg-5">
                <div class="premium-card p-4 h-100">
                    <h6 class="fw-bold mb-4 text-dark"><i class="bi bi-pie-chart-fill text-orange me-2"></i>Phân bổ lý do nghỉ phép</h6>
                    <div style="height: 250px;"><canvas id="pieChart"></canvas></div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="premium-card p-4 h-100">
                    <h6 class="fw-bold mb-4 text-dark"><i class="bi bi-graph-up text-orange me-2"></i>Tần suất vắng mặt theo tháng (Năm 2026)</h6>
                    <div style="height: 250px;"><canvas id="barChart"></canvas></div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <!-- Công việc bàn giao cho bạn -->
                <div class="premium-card mb-4 overflow-hidden">
                    <div class="p-4 d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #1d1d1f 0%, #3a3a3c 100%); color: white;">
                        <div class="d-flex align-items-center">
                            <div class="bg-success rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;"><i class="bi bi-briefcase-fill text-white fs-5"></i></div>
                            <div>
                                <h5 class="mb-0 fw-bold text-white">Công việc bàn giao cho bạn</h5>
                                <small class="text-white opacity-75">Bạn được phân công hỗ trợ đồng nghiệp</small>
                            </div>
                        </div>
                        <span class="badge bg-success rounded-pill px-3 py-2"><%= danhSachBanGiao ? danhSachBanGiao.length : 0 %> việc</span>
                    </div>
                    <div class="p-4" style="max-height: 320px; overflow-y: auto;" id="assignmentList">
                        <% if (!danhSachBanGiao || danhSachBanGiao.length === 0) { %>
                            <div class="text-center py-5 text-muted"><i class="bi bi-emoji-smile fs-1 d-block mb-2"></i><p class="mb-0">Hiện tại không có lịch nhận bàn giao công việc nào.</p></div>
                        <% } else { %>
                            <div class="vstack gap-3">
                                <% danhSachBanGiao.forEach(function(bg) { %>
                                    <div class="p-3 rounded-4 border bg-white d-flex flex-wrap justify-content-between align-items-center" style="transition: all 0.2s; border-color: rgba(140, 123, 69, 0.08) !important;">
                                        <div>
                                            <div class="fw-bold">Làm thay cho: <span class="text-orange" style="color: #8c7b45;"><%= bg.nguoi_nghi %></span> (<%= bg.email_nguoi_nghi %>)</div>
                                            <small class="text-muted"><i class="bi bi-calendar-range me-1"></i>Từ <%= new Date(bg.ngay_bat_dau).toLocaleDateString('vi-VN') %> → <%= new Date(bg.ngay_ket_thuc).toLocaleDateString('vi-VN') %></small>
                                            <div class="small text-secondary mt-1"><i class="bi bi-chat-right-text me-1"></i>Lý do: <%= bg.ly_do %></div>
                                        </div>
                                        <span class="badge-soft badge-soft-success rounded-pill px-3 py-1 small fw-semibold"><i class="bi bi-check-circle me-1"></i>Đang hiệu lực</span>
                                    </div>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Nhân sự vắng mặt hôm nay -->
                <div class="premium-card overflow-hidden">
                    <div class="p-4 border-bottom bg-light bg-opacity-25 d-flex justify-content-between align-items-center" style="border-color: rgba(140, 123, 69, 0.05) !important;">
                        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-people-fill text-orange me-2"></i>Nhân sự vắng mặt hôm nay</h6>
                        <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-sm" style="border-color: rgba(140, 123, 69, 0.08) !important;"><%= new Date().toLocaleDateString('vi-VN') %></span>
                    </div>
                    <div class="p-4">
                        <div class="table-responsive">
                            <table class="table table-custom align-middle mb-0">
                                <thead><tr><th>Nhân viên nghỉ</th><th>Phân loại</th><th>Người tiếp nhận</th><th>Trạng thái</th></tr></thead>
                                <tbody>
                                    <% if (!danhSachVangMat || danhSachVangMat.length === 0) { %>
                                        <tr><td colspan="4" class="text-center py-4 text-muted">🎉 Hôm nay không có ai vắng mặt</td></tr>
                                    <% } else { %>
                                        <% danhSachVangMat.forEach(function(v) { %>
                                            <tr>
                                                <td><div class="d-flex align-items-center"><div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;"><i class="bi bi-person"></i></div><span class="fw-semibold text-dark"><%= v.ho_ten %></span></div></td>
                                                <td><span class="badge-soft badge-soft-warning px-3 py-1 rounded-pill"><%= v.loai_nghi %></span></td>
                                                <td><div class="d-flex align-items-center text-secondary"><i class="bi bi-arrow-repeat me-2 text-muted"></i><%= v.nguoi_ban_giao %></div></td>
                                                <td><span class="badge-soft badge-soft-success px-3 py-1 rounded-pill"><i class="bi bi-check-lg me-1"></i>Đã bàn giao</span></td>
                                            </tr>
                                        <% }); %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- Khối đơn chờ duyệt (chỉ hiển thị nếu là quản trị/manager) -->
                <% if (user.ma_chuc_vu === 1 || user.ma_chuc_vu === 2) { %>
                    <div class="stat-card text-center p-4 d-flex flex-column align-items-center border-0" style="background: linear-gradient(135deg, #F3E6B3, #dfcf9b); color: #1d1d1f; min-height: 280px; justify-content: center;">
                        <div class="bg-dark bg-opacity-10 rounded-circle d-flex justify-content-center align-items-center mb-3" style="width: 85px; height: 85px;"><i class="bi bi-inbox-fill fs-1 text-dark"></i></div>
                        <h1 class="fw-bold mb-1 display-4" style="color: #1d1d1f; font-weight: 850;"><%= (typeof soDonChoDuyet !== 'undefined' ? (soDonChoDuyet < 10 ? '0' + soDonChoDuyet : soDonChoDuyet) : '00') %></h1>
                        <p class="mb-4 opacity-75 fw-medium text-dark">Đơn xin nghỉ đang chờ duyệt</p>
                        <a href="/duyet-don" class="btn btn-dark text-white fw-bold rounded-pill px-4 py-2 w-100 shadow-sm" style="background-color: #1d1d1f; border: none; padding: 12px;">Xử lý đơn ngay <i class="bi bi-arrow-right ms-1"></i></a>
                    </div>
                <% } else { %>
                    <div class="stat-card text-center p-4" style="min-height: 200px; justify-content: center;">
                        <div class="bg-light rounded-circle d-flex justify-content-center align-items-center mx-auto mb-3" style="width: 65px; height: 65px;"><i class="bi bi-calendar-event fs-2 text-orange" style="color: #8c7b45 !important;"></i></div>
                        <h6 class="fw-bold text-dark mb-2">Thông báo phòng ban</h6>
                        <p class="small text-muted mb-4">Hệ thống sẽ cập nhật trạng thái nhân sự vắng mặt để bạn sắp xếp công việc.</p>
                        <a href="/lich-su-nghi" class="btn btn-outline-secondary rounded-pill w-100" style="padding: 10px; border-radius: 12px;">Xem lịch sử của tôi</a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
    // Dữ liệu thống kê từ server
    const thongKeLoai = <%- JSON.stringify(thongKeLoai) %>;
    const thongKeThang = <%- JSON.stringify(thongKeThang) %>;

    // Vẽ biểu đồ tròn
    const pieLabels = thongKeLoai.map(item => item.loai_nghi);
    const pieData = thongKeLoai.map(item => item.so_luong);
    if (pieLabels.length === 0) {
        pieLabels.push('Chưa có dữ liệu');
        pieData.push(1);
    }
    new Chart(document.getElementById('pieChart'), {
        type: 'doughnut',
        data: { labels: pieLabels, datasets: [{ data: pieData, backgroundColor: ['#F3E6B3', '#dfcf9b', '#34c759', '#5e5ce0', '#e5e5ea'], borderWidth: 0, hoverOffset: 8 }] },
        options: { cutout: '68%', responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'bottom', labels: { font: { size: 11, family: 'Helvetica Neue' }, usePointStyle: true } } } }
    });

    // Vẽ biểu đồ cột
    const barData = new Array(12).fill(0);
    thongKeThang.forEach(item => { if (item.thang >= 1 && item.thang <= 12) barData[item.thang - 1] = item.tong_ngay; });
    new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: { labels: ['Th1','Th2','Th3','Th4','Th5','Th6','Th7','Th8','Th9','Th10','Th11','Th12'], datasets: [{ label: 'Số ngày nghỉ', data: barData, backgroundColor: '#F3E6B3', hoverBackgroundColor: '#e2d39d', borderRadius: 8, barPercentage: 0.65 }] },
        options: { responsive: true, maintainAspectRatio: true, scales: { y: { beginAtZero: true, grid: { color: '#f0ede4' }, ticks: { stepSize: 1, precision: 0 } }, x: { grid: { display: false } } }, plugins: { legend: { display: false }, tooltip: { backgroundColor: '#1d1d1f' } } }
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>