<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bảng điều khiển - Present Portal</title>
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        /* Reset & font Apple */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #e5e5ea; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #c1c1c4; }

        body {
            background-color: #f5f5f7;
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            color: #1d1d1f;
            overflow-x: hidden;
        }

        .text-orange { color: #f26522 !important; }
        .bg-orange { background-color: #f26522 !important; }
        .btn-orange {
            background-color: #f26522;
            color: white;
            border: none;
            font-weight: 600;
            padding: 10px 20px;
            border-radius: 14px;
            transition: all 0.2s ease;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }
        .btn-orange:hover {
            background-color: #e05a1c;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(242, 101, 34, 0.25);
        }

        .wrapper { display: flex; width: 100%; align-items: stretch; }

        /* Sidebar – đồng bộ với duyệt đơn, lịch sử */
        #sidebar {
            min-width: 270px;
            max-width: 270px;
            background: #ffffff;
            min-height: 100vh;
            border-right: 1px solid rgba(0,0,0,0.05);
            display: flex;
            flex-direction: column;
            position: fixed;
            box-shadow: 2px 0 20px rgba(0,0,0,0.02);
            z-index: 10;
        }
        .sidebar-header { padding: 32px 24px 0 24px; }
        .nav-link {
            color: #515154;
            padding: 12px 20px;
            font-weight: 500;
            border-radius: 14px;
            margin: 4px 16px;
            transition: all 0.2s;
            font-size: 0.95rem;
        }
        .nav-link i { margin-right: 12px; font-size: 1.2rem; width: 24px; text-align: center; }
        .nav-link:hover { background: #fef2ec; color: #f26522; }
        .nav-link.active { background: #f26522; color: #ffffff; box-shadow: 0 6px 12px rgba(242, 101, 34, 0.18); }
        .sidebar-heading {
            font-size: 0.7rem;
            letter-spacing: 0.5px;
            font-weight: 700;
            color: #8e8e93;
            padding-left: 24px;
            margin-top: 20px;
            margin-bottom: 8px;
        }
        .sidebar-footer {
            margin-top: auto;
            padding: 24px;
            border-top: 1px solid rgba(0,0,0,0.05);
        }

        /* Main content */
        #content {
            width: calc(100% - 270px);
            margin-left: 270px;
            padding: 36px 44px;
        }

        /* Cards thống kê */
        .stat-card {
            background: white;
            border-radius: 28px;
            border: 1px solid rgba(0,0,0,0.04);
            padding: 1.6rem;
            box-shadow: 0 6px 18px rgba(0,0,0,0.02);
            transition: all 0.25s ease;
            height: 100%;
        }
        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 28px -12px rgba(0,0,0,0.08);
        }
        .stat-title {
            font-size: 0.7rem;
            font-weight: 700;
            color: #86868b;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            margin-bottom: 10px;
        }
        .stat-value { font-size: 2.4rem; font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; }

        /* Bảng */
        .table-custom thead th {
            border-bottom: 1px solid rgba(0,0,0,0.05);
            color: #86868b;
            font-size: 0.73rem;
            text-transform: uppercase;
            font-weight: 600;
            padding-bottom: 12px;
        }
        .table-custom tbody td {
            border-bottom: 1px solid rgba(0,0,0,0.03);
            padding: 14px 8px;
            vertical-align: middle;
        }
        .badge-soft-warning {
            background-color: #fff1e0;
            color: #c93a00;
            font-weight: 500;
            padding: 6px 12px;
            border-radius: 40px;
        }
        .badge-soft-success {
            background-color: #e6f4ea;
            color: #1e7b3c;
        }

        @media (max-width: 992px) {
            #sidebar { transform: translateX(-100%); position: fixed; }
            #content { width: 100%; margin-left: 0; padding: 24px; }
        }
    </style>
</head>
<body>
<div class="wrapper">
    <!-- Sidebar – giống hệt duyệt đơn và lịch sử -->
    <nav id="sidebar">
        <div class="sidebar-header d-flex align-items-center mb-2">
            <div class="bg-orange rounded-3 p-2 me-3 shadow-sm" style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-buildings text-white fs-5"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-bold" style="letter-spacing: -0.3px;">Present</h5>
                <small class="text-muted fw-medium" style="font-size: 0.7rem;">Hệ thống Nhân sự</small>
            </div>
        </div>

        <ul class="nav flex-column mt-2">
            <li class="nav-item"><a href="/dashboard" class="nav-link active"><i class="bi bi-grid-1x2-fill"></i> Tổng quan</a></li>
            <div class="sidebar-heading">CÁ NHÂN</div>
            <li class="nav-item"><a href="/bang-luong" class="nav-link"><i class="bi bi-cash-stack"></i> Phiếu lương</a></li>
            <div class="sidebar-heading">QUẢN LÝ ĐƠN TỪ</div>
            <li class="nav-item"><a href="/tao-don" class="nav-link"><i class="bi bi-pencil-square"></i> Tạo đơn xin nghỉ</a></li>
            <li class="nav-item"><a href="/lich-su-nghi" class="nav-link"><i class="bi bi-clock-history"></i> Lịch sử đơn từ</a></li>

            <% if (user.ma_chuc_vu === 1 || user.ma_chuc_vu === 2) { %>
                <div class="sidebar-heading">QUẢN TRỊ VIÊN</div>
                <li class="nav-item"><a href="/duyet-don" class="nav-link"><i class="bi bi-check2-square"></i> Duyệt đơn 
                    <% if (typeof soDonChoDuyet !== 'undefined' && soDonChoDuyet > 0) { %>
                        <span class="badge bg-danger ms-2 rounded-pill"><%= soDonChoDuyet %></span>
                    <% } %>
                </a></li>
                <li class="nav-item"><a href="/quan-ly-nhan-su" class="nav-link"><i class="bi bi-people-fill"></i> Hồ sơ Nhân sự</a></li>
            <% } %>
        </ul>

        <div class="sidebar-footer">
            <div class="d-flex align-items-center mb-3 px-2">
                <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.ho_ten) %>&background=f26522&color=fff&bold=true&rounded=true&size=42" width="42" height="42" class="me-3 shadow-sm rounded-circle">
                <div>
                    <h6 class="mb-0 fw-bold"><%= user.ho_ten %></h6>
                    <small class="text-muted"><%= user.email %></small>
                    <% if (user.ma_chuc_vu === 1) { %><div><span class="badge bg-orange bg-opacity-10 text-orange px-2 mt-1" style="font-size: 10px;">Quản trị viên</span></div><% } %>
                    <% if (user.ma_chuc_vu === 2) { %><div><span class="badge bg-orange bg-opacity-10 text-orange px-2 mt-1" style="font-size: 10px;">Quản lý</span></div><% } %>
                </div>
            </div>
            <a href="/dang-xuat" class="btn btn-light w-100 fw-semibold" style="color: #ff3b30; border-radius: 14px; background: #fff5f5;"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
        </div>
    </nav>

    <!-- Nội dung chính -->
    <div id="content">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-5">
            <div>
                <h2 class="fw-bold mb-1" style="letter-spacing: -0.5px;">Bảng điều khiển</h2>
                <p class="text-muted mb-0">Theo dõi quỹ phép và tình hình điều phối nhân sự hôm nay</p>
            </div>
            <a href="/tao-don" class="btn btn-orange mt-2 mt-sm-0 shadow-sm"><i class="bi bi-plus-lg me-2"></i>Tạo đơn mới</a>
        </div>

        <!-- 3 thẻ quỹ phép (dữ liệu từ user) -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-title">Quỹ phép năm nay</div>
                    <div class="stat-value text-primary"><%= user.tong_ngay_phep %> <span class="fs-5 text-muted fw-medium">ngày</span></div>
                    <div class="mt-3 text-muted small"><i class="bi bi-info-circle me-1"></i>Cấp theo quy định</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-title">Đã sử dụng</div>
                    <div class="stat-value" style="color: #ff5a4a;"><%= user.ngay_phep_da_dung %> <span class="fs-5 text-muted fw-medium">ngày</span></div>
                    <div class="mt-3 text-muted small"><i class="bi bi-calendar-minus me-1"></i>Đã trừ vào quỹ</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card" style="border-left: 3px solid #28a745;">
                    <div class="stat-title text-success">Còn lại có thể dùng</div>
                    <div class="stat-value text-success"><%= user.tong_ngay_phep - user.ngay_phep_da_dung %> <span class="fs-5 text-muted fw-medium">ngày</span></div>
                    <div class="mt-3 text-success small"><i class="bi bi-check-circle me-1"></i>Khả dụng ngay</div>
                </div>
            </div>
        </div>

        <!-- Biểu đồ thống kê (nhận dữ liệu từ controller) -->
        <div class="row g-4 mb-5">
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3"><i class="bi bi-pie-chart-fill text-orange me-2"></i>Phân bổ lý do nghỉ phép</h6>
                        <div style="height: 250px;"><canvas id="pieChart"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3"><i class="bi bi-graph-up text-orange me-2"></i>Tần suất vắng mặt theo tháng (Năm 2026)</h6>
                        <div style="height: 250px;"><canvas id="barChart"></canvas></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <!-- Công việc bàn giao cho bạn -->
                <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden">
                    <div class="bg-dark text-white p-4 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <div class="bg-success rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;"><i class="bi bi-briefcase-fill text-white fs-5"></i></div>
                            <div><h5 class="mb-0 fw-bold">Công việc được bàn giao cho bạn</h5><small>Bạn được phân công hỗ trợ đồng nghiệp</small></div>
                        </div>
                        <span class="badge bg-success rounded-pill px-3 py-2"><%= danhSachBanGiao ? danhSachBanGiao.length : 0 %> việc</span>
                    </div>
                    <div class="card-body p-4" style="max-height: 320px; overflow-y: auto;" id="assignmentList">
                        <% if (!danhSachBanGiao || danhSachBanGiao.length === 0) { %>
                            <div class="text-center py-5 text-muted"><i class="bi bi-emoji-smile fs-1 d-block mb-2"></i><p>Hiện tại không có lịch nhận bàn giao công việc nào.</p></div>
                        <% } else { %>
                            <div class="vstack gap-3">
                                <% danhSachBanGiao.forEach(function(bg) { %>
                                    <div class="p-3 rounded-4 border bg-white d-flex flex-wrap justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-bold">Làm thay cho: <span class="text-orange"><%= bg.nguoi_nghi %></span> (<%= bg.email_nguoi_nghi %>)</div>
                                            <small class="text-muted"><i class="bi bi-calendar-range"></i> Từ <%= new Date(bg.ngay_bat_dau).toLocaleDateString('vi-VN') %> → <%= new Date(bg.ngay_ket_thuc).toLocaleDateString('vi-VN') %></small>
                                            <div class="small text-secondary mt-1"><i class="bi bi-chat-right-text"></i> Lý do: <%= bg.ly_do %></div>
                                        </div>
                                        <span class="badge-soft-success rounded-pill px-3 py-1 small fw-semibold"><i class="bi bi-check-circle"></i> Đang hiệu lực</span>
                                    </div>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Nhân sự vắng mặt hôm nay -->
                <div class="stat-card p-0 overflow-hidden rounded-4">
                    <div class="p-4 border-bottom bg-light bg-opacity-25 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0"><i class="bi bi-people-fill text-orange me-2"></i>Nhân sự vắng mặt hôm nay</h6>
                        <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-sm"><%= new Date().toLocaleDateString('vi-VN') %></span>
                    </div>
                    <div class="p-4">
                        <div class="table-responsive">
                            <table class="table table-custom align-middle mb-0">
                                <thead><tr><th>Nhân viên nghỉ</th><th>Phân loại</th><th>Người tiếp nhận</th><th>Trạng thái</th></tr></thead>
                                <tbody>
                                    <% if (!danhSachVangMat || danhSachVangMat.length === 0) { %>
                                        <tr><td colspan="4" class="text-center py-4 text-muted">🎉 Hôm nay không có ai vắng mặt</td></tr>
                                    <% } else { %>
                                        <% danhSachVangMat.forEach(function(v) { %>
                                            <tr>
                                                <td><div class="d-flex align-items-center"><div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;"><i class="bi bi-person"></i></div><span class="fw-semibold"><%= v.ho_ten %></span></div></td>
                                                <td><span class="badge-soft-warning px-3 py-1 rounded-pill"><%= v.loai_nghi %></span></td>
                                                <td><div class="d-flex align-items-center"><i class="bi bi-arrow-repeat me-2 text-secondary"></i><%= v.nguoi_ban_giao %></div></td>
                                                <td><span class="badge-soft-success px-3 py-1 rounded-pill"><i class="bi bi-check-lg me-1"></i>Đã bàn giao</span></td>
                                            </tr>
                                        <% }); %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- Khối đơn chờ duyệt (chỉ hiển thị nếu là quản trị/manager) -->
                <% if (user.ma_chuc_vu === 1 || user.ma_chuc_vu === 2) { %>
                    <div class="stat-card text-center p-4 d-flex flex-column align-items-center border-0" style="background: linear-gradient(135deg, #f26522, #ff8c00); color: white;">
                        <div class="bg-white bg-opacity-20 rounded-circle d-flex justify-content-center align-items-center mb-3" style="width: 85px; height: 85px;"><i class="bi bi-inbox-fill fs-1 text-white"></i></div>
                        <h1 class="fw-bold mb-1 display-4"><%= (typeof soDonChoDuyet !== 'undefined' ? (soDonChoDuyet < 10 ? '0' + soDonChoDuyet : soDonChoDuyet) : '00') %></h1>
                        <p class="mb-3 opacity-75 fw-medium">Đơn xin nghỉ đang chờ duyệt</p>
                        <a href="/duyet-don" class="btn btn-light text-orange fw-bold rounded-pill px-4 py-2 w-100 shadow-sm">Xử lý đơn ngay <i class="bi bi-arrow-right"></i></a>
                    </div>
                <% } else { %>
                    <div class="stat-card text-center">
                        <div class="bg-light rounded-circle d-flex justify-content-center align-items-center mx-auto mb-3" style="width: 65px; height: 65px;"><i class="bi bi-calendar-event fs-1 text-orange"></i></div>
                        <h6 class="fw-bold">Thông báo phòng ban</h6>
                        <p class="small text-muted">Hệ thống sẽ cập nhật trạng thái nhân sự vắng mặt để bạn sắp xếp công việc.</p>
                        <a href="/lich-su-nghi" class="btn btn-outline-secondary rounded-pill w-100">Xem lịch sử của tôi</a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
    // Dữ liệu thống kê từ server (EJS)
    const thongKeLoai = <%- typeof thongKeLoai !== 'undefined' ? JSON.stringify(thongKeLoai) : '[]' %>;
    const thongKeThang = <%- typeof thongKeThang !== 'undefined' ? JSON.stringify(thongKeThang) : '[]' %>;

    // Vẽ biểu đồ tròn
    const pieLabels = thongKeLoai.map(item => item.loai_nghi);
    const pieData = thongKeLoai.map(item => item.so_luong);
    if (pieLabels.length === 0) {
        pieLabels.push('Chưa có dữ liệu');
        pieData.push(1);
    }
    new Chart(document.getElementById('pieChart'), {
        type: 'doughnut',
        data: { labels: pieLabels, datasets: [{ data: pieData, backgroundColor: ['#f26522', '#ffb020', '#34c759', '#5e5ce0', '#e5e5ea'], borderWidth: 0, hoverOffset: 8 }] },
        options: { cutout: '68%', responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'bottom', labels: { font: { size: 11 }, usePointStyle: true } } } }
    });

    // Vẽ biểu đồ cột
    const barData = new Array(12).fill(0);
    thongKeThang.forEach(item => { if (item.thang >= 1 && item.thang <= 12) barData[item.thang - 1] = item.tong_ngay; });
    new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: { labels: ['Th1','Th2','Th3','Th4','Th5','Th6','Th7','Th8','Th9','Th10','Th11','Th12'], datasets: [{ label: 'Số ngày nghỉ', data: barData, backgroundColor: '#f26522', borderRadius: 8, barPercentage: 0.65 }] },
        options: { responsive: true, maintainAspectRatio: true, scales: { y: { beginAtZero: true, grid: { color: '#efefef' }, ticks: { stepSize: 1, precision: 0 } }, x: { grid: { display: false } } }, plugins: { legend: { display: false }, tooltip: { backgroundColor: '#1d1d1f' } } }
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>