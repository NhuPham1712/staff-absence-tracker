<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - Công ty Present</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Tùy chỉnh tông màu cam */
        body {
            background: linear-gradient(135deg, #fff8f0 0%, #ffe5d0 100%);
            height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .text-orange { color: #f26522 !important; }
        .btn-orange {
            background-color: #f26522;
            border-color: #f26522;
            color: #fff;
            transition: all 0.3s ease;
        }
        .btn-orange:hover {
            background-color: #d9531e;
            border-color: #d9531e;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(242, 101, 34, 0.3);
        }
        .card-custom {
            border-radius: 20px;
            border: none;
            box-shadow: 0 15px 35px rgba(242, 101, 34, 0.1);
        }
        .form-control:focus {
            border-color: #f26522;
            box-shadow: 0 0 0 0.25rem rgba(242, 101, 34, 0.25);
        }
    </style>
</head>
<body class="d-flex align-items-center">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card card-custom">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <!-- Logo chữ -->
                            <h2 class="fw-bolder text-orange mb-1">PRESENT</h2>
                            <p class="text-muted small">Hệ thống Quản lý Nhân sự</p>
                        </div>
                        
                        <!-- Form Đăng nhập -->
                        <form action="/xu-ly-dang-nhap" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-secondary small">Email công việc</label>
                                <input type="email" class="form-control form-control-lg bg-light" name="email" placeholder="Nhập email..." required>
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-secondary small">Mật khẩu</label>
                                <input type="password" class="form-control form-control-lg bg-light" name="mat_khau" placeholder="Nhập mật khẩu..." required>
                            </div>
                            <button type="submit" class="btn btn-orange btn-lg w-100 fw-bold">ĐĂNG NHẬP</button>
                        </form>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>