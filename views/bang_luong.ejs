<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phiếu lương - Present Portal</title>
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        /* Reset & premium fonts */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #e5e5ea; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #c1c1c4; }

        body {
            background-color: #faf9f5;
            font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            color: #1d1d1f;
            overflow-x: hidden;
        }

        .text-orange { color: #8c7b45 !important; }
        .bg-orange { background-color: #F3E6B3 !important; }
        
        .btn-orange {
            background: linear-gradient(135deg, #F3E6B3 0%, #e2d39d 100%);
            color: #3d3516;
            border: none;
            font-weight: 600;
            padding: 12px 24px;
            border-radius: 14px;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 4px 12px rgba(243, 230, 179, 0.3);
        }
        
        .btn-orange:hover {
            background: linear-gradient(135deg, #e2d39d 0%, #d1c18c 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(243, 230, 179, 0.5);
            color: #241f0b;
        }

        .wrapper { display: flex; width: 100%; align-items: stretch; }
        
        /* Premium Sidebar */
        #sidebar {
            min-width: 270px;
            max-width: 270px;
            background: #ffffff;
            min-height: 100vh;
            border-right: 1px solid rgba(0,0,0,0.04);
            display: flex;
            flex-direction: column;
            position: fixed;
            box-shadow: 4px 0 24px rgba(140, 123, 69, 0.02);
            z-index: 10;
        }
        
        .sidebar-header { padding: 32px 24px 20px 24px; }
        
        .nav-link {
            color: #515154;
            padding: 12px 20px;
            font-weight: 500;
            border-radius: 14px;
            margin: 4px 16px;
            transition: all 0.25s ease;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
        }
        
        .nav-link i { margin-right: 12px; font-size: 1.2rem; width: 24px; text-align: center; }
        .nav-link:hover { background: rgba(243, 230, 179, 0.12); color: #8c7b45; }
        
        .nav-link.active {
            background: linear-gradient(135deg, #F3E6B3 0%, #e2d39d 100%);
            color: #3d3516;
            box-shadow: 0 6px 15px rgba(243, 230, 179, 0.35);
            font-weight: 600;
        }
        
        .sidebar-heading {
            font-size: 0.7rem;
            letter-spacing: 0.8px;
            font-weight: 700;
            color: #9e9e9f;
            padding-left: 24px;
            margin-top: 24px;
            margin-bottom: 8px;
            text-transform: uppercase;
        }
        
        .sidebar-footer {
            margin-top: auto;
            padding: 24px;
            border-top: 1px solid rgba(0,0,0,0.04);
        }

        #content {
            width: calc(100% - 270px);
            margin-left: 270px;
            padding: 40px 50px;
        }
        
        /* Premium Payslip Design */
        .payslip-container { 
            background: #ffffff; 
            border-radius: 32px; 
            box-shadow: 0 20px 50px rgba(140, 123, 69, 0.05); 
            max-width: 950px; 
            margin: 0 auto; 
            padding: 50px 60px;
            border: 1px solid rgba(140, 123, 69, 0.08);
        }
        
        .brand-logo { 
            width: 50px; 
            height: 50px; 
            background: linear-gradient(135deg, #F3E6B3 0%, #e2d39d 100%);
            color: #3d3516; 
            border-radius: 16px; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            font-size: 1.5rem; 
        }
        
        .info-label { font-size: 0.75rem; letter-spacing: 1px; color: #86868b; text-transform: uppercase; font-weight: 750; margin-bottom: 5px; }
        .info-value { font-size: 1.05rem; font-weight: 600; color: #1d1d1f; }
        
        .section-title { font-size: 1.15rem; font-weight: 700; color: #1d1d1f; margin-bottom: 24px; display: flex; align-items: center; }
        .section-title i { font-size: 1.4rem; margin-right: 12px; }
        
        .amount-row { display: flex; justify-content: space-between; padding: 18px 0; border-bottom: 1px solid #f2f2f7; font-size: 0.95rem; align-items: center; }
        .amount-row:last-child { border-bottom: none; }
        .amount-label { color: #515154; font-weight: 500; }
        .amount-value { font-weight: 700; font-size: 1.05rem; }
        
        /* Dark Card Effect for Net Pay */
        .premium-net-box { 
            background: linear-gradient(135deg, #1d1d1f 0%, #2c2c2e 100%); 
            border-radius: 24px; 
            padding: 40px; 
            margin-top: 40px; 
            color: white;
            box-shadow: 0 20px 45px rgba(29, 29, 31, 0.18);
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(243, 230, 179, 0.15);
        }
        
        /* Golden aura glow effect */
        .premium-net-box::after {
            content: ''; position: absolute; top: -50%; right: -20%; width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(243, 230, 179, 0.15) 0%, transparent 70%);
            border-radius: 50%; pointer-events: none;
        }
        
        .net-amount { font-size: 3.5rem; font-weight: 800; letter-spacing: -1px; line-height: 1; color: #F3E6B3; text-shadow: 0 0 15px rgba(243, 230, 179, 0.25); }
        .currency { font-size: 1.5rem; font-weight: 600; vertical-align: text-top; margin-left: 5px; color: #F3E6B3; opacity: 0.9; }

        @media (max-width: 992px) {
            #sidebar { transform: translateX(-100%); position: fixed; }
            #content { width: 100%; margin-left: 0; padding: 30px 20px; }
            .payslip-container { padding: 35px 30px; }
        }

        /* Printable styles */
        @media print {
            body { background-color: #ffffff; }
            #sidebar { display: none !important; }
            #content { width: 100% !important; margin-left: 0 !important; padding: 0 !important; }
            .payslip-container { box-shadow: none !important; border: none !important; padding: 0 !important; }
            .btn { display: none !important; }
            .premium-net-box {
                background: #1d1d1f !important;
                color: #ffffff !important;
                border: 1px solid #000000 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            .net-amount, .currency {
                color: #F3E6B3 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar">
            <div class="sidebar-header d-flex align-items-center mb-2">
                <div class="bg-orange rounded-3 p-2 me-3 shadow-sm" style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-buildings text-dark fs-5"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold" style="letter-spacing: -0.3px;">Present</h5>
                    <small class="text-muted fw-medium" style="font-size: 0.7rem;">Hệ thống Nhân sự</small>
                </div>
            </div>

            <ul class="nav flex-column mt-2">
                <li class="nav-item"><a href="/dashboard" class="nav-link"><i class="bi bi-grid-1x2-fill"></i> Tổng quan</a></li>
                <div class="sidebar-heading">CÁ NHÂN</div>
                <li class="nav-item"><a href="/bang-luong" class="nav-link active"><i class="bi bi-cash-stack"></i> Phiếu lương</a></li>
                <div class="sidebar-heading">QUẢN LÝ ĐƠN TỪ</div>
                <li class="nav-item"><a href="/tao-don" class="nav-link"><i class="bi bi-pencil-square"></i> Tạo đơn xin nghỉ</a></li>
                <li class="nav-item"><a href="/lich-su-nghi" class="nav-link"><i class="bi bi-clock-history"></i> Lịch sử đơn từ</a></li>

                <% if (user.ma_chuc_vu === 1 || user.ma_chuc_vu === 2) { %>
                    <div class="sidebar-heading">QUẢN TRỊ VIÊN</div>
                    <li class="nav-item"><a href="/duyet-don" class="nav-link"><i class="bi bi-check2-square"></i> Duyệt đơn 
                        <% if (typeof soDonChoDuyet !== 'undefined' && soDonChoDuyet > 0) { %>
                            <span class="badge bg-danger ms-2 rounded-pill"><%= soDonChoDuyet %></span>
                        <% } %>
                    </a></li>
                    <li class="nav-item"><a href="/quan-ly-nhan-su" class="nav-link"><i class="bi bi-people-fill"></i> Hồ sơ Nhân sự</a></li>
                <% } %>
            </ul>
            
            <div class="sidebar-footer">
                <div class="d-flex align-items-center mb-3 px-2">
                    <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.ho_ten) %>&background=F3E6B3&color=1d1d1f&bold=true&rounded=true&size=42" width="42" height="42" class="me-3 shadow-sm rounded-circle">
                    <div>
                        <h6 class="mb-0 fw-bold"><%= user.ho_ten %></h6>
                        <small class="text-muted d-block text-truncate" style="max-width: 150px; font-size: 0.8rem;"><%= user.email %></small>
                    </div>
                </div>
                <a href="/dang-xuat" class="btn btn-light w-100 fw-semibold" style="color: #ff3b30; border-radius: 14px; background: #fff5f5; border: none; padding: 10px;"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
            </div>
        </nav>

        <div id="content">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-5">
                <div>
                    <h2 class="fw-bold mb-1" style="letter-spacing: -1px;">Thu nhập Cá nhân</h2>
                    <p class="text-muted mb-0">Báo cáo chi tiết kỳ lương Tháng <%= chiTietLuong.thang %></p>
                </div>
                <button class="btn btn-orange shadow-sm mt-3 mt-sm-0 px-4 py-2.5 rounded-pill" onclick="window.print()">
                    <i class="bi bi-printer me-2"></i>In phiếu lương
                </button>
            </div>

            <div class="payslip-container">
                <div class="d-flex justify-content-between align-items-start border-bottom pb-5 mb-5" style="border-color: #f0f0f5 !important;">
                    <div class="d-flex align-items-center">
                        <div class="brand-logo me-4 shadow-sm"><i class="bi bi-buildings-fill"></i></div>
                        <div>
                            <h3 class="fw-bold text-dark mb-1" style="letter-spacing: -1px;">Phiếu thanh toán Lương</h3>
                            <div class="text-muted fw-medium" style="font-size: 0.95rem;">Công ty TNHH Công nghệ Present</div>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="badge-soft badge-soft-champagne px-3 py-2 fw-semibold mb-2" style="border-radius: 12px; font-size: 0.85rem;">
                            Kỳ lương: Tháng <%= chiTietLuong.thang %> / <%= chiTietLuong.nam %>
                        </div>
                        <div class="text-muted small">Ngày xuất: <%= new Date().toLocaleDateString('vi-VN') %></div>
                    </div>
                </div>

                <div class="row mb-5 pb-4 border-bottom" style="border-color: #f0f0f5 !important;">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <div class="info-label">Nhân sự</div>
                        <div class="info-value"><%= user.ho_ten %></div>
                    </div>
                    <div class="col-md-4 mb-3 mb-md-0">
                        <div class="info-label">Chức danh / Phòng ban</div>
                        <div class="info-value"><%= user.phong_ban %></div>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <div class="info-label">Liên hệ</div>
                        <div class="info-value"><%= user.email %></div>
                    </div>
                </div>

                <div class="row g-5">
                    <div class="col-md-6">
                        <div class="section-title text-dark">
                            <i class="bi bi-arrow-down-circle-fill text-success opacity-75"></i> Các khoản Thu nhập
                        </div>
                        <div class="pe-md-3">
                            <div class="amount-row">
                                <span class="amount-label">Lương cơ bản (Gross)</span>
                                <span class="amount-value text-dark"><%= chiTietLuong.luongCoBan.toLocaleString('vi-VN') %> đ</span>
                            </div>
                            <div class="amount-row">
                                <span class="amount-label">Phụ cấp (Ăn trưa, xăng xe)</span>
                                <span class="amount-value text-dark"><%= chiTietLuong.phuCap.toLocaleString('vi-VN') %> đ</span>
                            </div>
                            <div class="amount-row">
                                <span class="amount-label">Làm thêm ngoài giờ (OT)</span>
                                <span class="amount-value text-dark"><%= chiTietLuong.tienOT.toLocaleString('vi-VN') %> đ</span>
                            </div>
                            <div class="amount-row">
                                <span class="amount-label">Thưởng / Bonus</span>
                                <span class="amount-value text-dark"><%= chiTietLuong.thuong.toLocaleString('vi-VN') %> đ</span>
                            </div>
                            <div class="amount-row mt-3 pt-4" style="border-top: 2px solid #1d1d1f; border-bottom: none;">
                                <span class="fw-bold text-dark text-uppercase" style="font-size: 0.9rem; letter-spacing: 1px;">Tổng Thu Nhập</span>
                                <span class="fw-bold text-dark fs-5"><%= chiTietLuong.tongThuNhap.toLocaleString('vi-VN') %> đ</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="section-title text-dark">
                            <i class="bi bi-arrow-up-circle-fill text-danger opacity-75"></i> Các khoản Khấu trừ
                        </div>
                        <div class="ps-md-3">
                            <div class="amount-row">
                                <span class="amount-label">Nghỉ Việc riêng (<%= chiTietLuong.soNgayBiTru %> ngày)</span>
                                <span class="amount-value text-danger">- <%= chiTietLuong.truNghiViecRieng.toLocaleString('vi-VN') %> đ</span>
                            </div>
                            <div class="amount-row">
                                <span class="amount-label">BHXH, BHYT, BHTN (10.5%)</span>
                                <span class="amount-value text-danger">- <%= chiTietLuong.baoHiem.toLocaleString('vi-VN') %> đ</span>
                            </div>
                            <div class="amount-row">
                                <span class="amount-label">Thuế thu nhập cá nhân</span>
                                <span class="amount-value text-muted">Được miễn giảm</span>
                            </div>
                            <div class="amount-row mt-3 pt-4" style="border-top: 2px solid #1d1d1f; border-bottom: none;">
                                <span class="fw-bold text-dark text-uppercase" style="font-size: 0.9rem; letter-spacing: 1px;">Tổng Khấu Trừ</span>
                                <span class="fw-bold text-danger fs-5">- <%= chiTietLuong.tongKhauTru.toLocaleString('vi-VN') %> đ</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="premium-net-box d-flex flex-column flex-md-row justify-content-between align-items-center">
                    <div class="mb-3 mb-md-0 position-relative" style="z-index: 2;">
                        <h4 class="fw-bold text-white mb-1">Lương Thực Nhận (NET)</h4>
                        <div class="text-white opacity-75" style="font-size: 0.95rem;">Đã bao gồm thanh toán phụ cấp và trừ bảo hiểm</div>
                    </div>
                    <div class="text-end position-relative" style="z-index: 2;">
                        <div class="net-amount">
                            <%= chiTietLuong.thucLanh.toLocaleString('vi-VN') %><span class="currency">VNĐ</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>