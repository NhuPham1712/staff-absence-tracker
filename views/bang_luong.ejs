<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phiếu lương - Present Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f5f5f7; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif; color: #1d1d1f; overflow-x: hidden; }
        .text-orange { color: #f26522 !important; }
        .bg-orange { background-color: #f26522 !important; color: white; }
        .wrapper { display: flex; width: 100%; align-items: stretch; }
        
        /* Sidebar */
        #sidebar { min-width: 260px; max-width: 260px; background: #ffffff; min-height: 100vh; border-right: 1px solid rgba(0,0,0,0.05); display: flex; flex-direction: column; position: fixed; z-index: 10; }
        .sidebar-header { padding: 30px 24px; }
        .nav-link { color: #515154; padding: 12px 20px; font-weight: 500; border-radius: 12px; margin: 4px 16px; transition: all 0.2s; font-size: 0.95rem;}
        .nav-link i { margin-right: 12px; font-size: 1.2rem; vertical-align: text-bottom;}
        .nav-link:hover, .nav-link.active { background: #fff3ed; color: #f26522; }
        .nav-link.active { background: #f26522; color: #ffffff; box-shadow: 0 4px 10px rgba(242, 101, 34, 0.25); }
        .sidebar-footer { margin-top: auto; padding: 24px; border-top: 1px solid rgba(0,0,0,0.05); }
        #content { width: calc(100% - 260px); margin-left: 260px; padding: 40px 50px; }
        
        /* Premium Payslip Design */
        .payslip-container { 
            background: #ffffff; 
            border-radius: 32px; 
            box-shadow: 0 20px 40px rgba(0,0,0,0.02); 
            max-width: 950px; 
            margin: 0 auto; 
            padding: 60px 70px;
            border: 1px solid rgba(0,0,0,0.03);
        }
        
        .brand-logo { width: 50px; height: 50px; background: #1d1d1f; color: #fff; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
        
        .info-label { font-size: 0.75rem; letter-spacing: 1px; color: #86868b; text-transform: uppercase; font-weight: 700; margin-bottom: 5px; }
        .info-value { font-size: 1.1rem; font-weight: 600; color: #1d1d1f; }
        
        .section-title { font-size: 1.2rem; font-weight: 700; color: #1d1d1f; margin-bottom: 24px; display: flex; align-items: center; }
        .section-title i { font-size: 1.5rem; margin-right: 12px; }
        
        .amount-row { display: flex; justify-content: space-between; padding: 18px 0; border-bottom: 1px solid #f0f0f5; font-size: 1rem; align-items: center; }
        .amount-row:last-child { border-bottom: none; }
        .amount-label { color: #515154; font-weight: 500; }
        .amount-value { font-weight: 700; font-size: 1.1rem; }
        
        /* Black Card Effect cho Thực Lãnh */
        .premium-net-box { 
            background: linear-gradient(135deg, #1d1d1f 0%, #3a3a3c 100%); 
            border-radius: 24px; 
            padding: 40px; 
            margin-top: 40px; 
            color: white;
            box-shadow: 0 20px 40px rgba(29,29,31,0.15);
            position: relative;
            overflow: hidden;
        }
        /* Hiệu ứng bóng mờ sang trọng */
        .premium-net-box::after {
            content: ''; position: absolute; top: -50%; right: -20%; width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(52, 199, 89, 0.2) 0%, transparent 70%);
            border-radius: 50%; pointer-events: none;
        }
        
        .net-amount { font-size: 3.5rem; font-weight: 800; letter-spacing: -1px; line-height: 1; color: #34c759; }
        .currency { font-size: 1.5rem; font-weight: 600; vertical-align: text-top; margin-left: 5px; color: #fff; opacity: 0.8; }
    </style>
</head>
<body>
    <div class="wrapper">
        <nav id="sidebar">
            <div class="sidebar-header d-flex align-items-center mb-2">
                <div class="bg-orange rounded-3 p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <i class="bi bi-buildings text-white fs-5"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold text-dark">Present</h5>
                    <small class="text-muted fw-medium">Hệ thống Nhân sự</small>
                </div>
            </div>
            <ul class="nav flex-column mt-2">
                <li class="nav-item"><a href="/dashboard" class="nav-link"><i class="bi bi-grid-1x2-fill"></i> Tổng quan</a></li>
                <h6 class="sidebar-heading px-4 mt-4 mb-2 text-muted small fw-bold">CÁ NHÂN</h6>
                <li class="nav-item"><a href="/bang-luong" class="nav-link active"><i class="bi bi-cash-stack"></i> Phiếu lương</a></li>
                <h6 class="sidebar-heading px-4 mt-4 mb-2 text-muted small fw-bold">QUẢN LÝ ĐƠN TỪ</h6>
                <li class="nav-item"><a href="/tao-don" class="nav-link"><i class="bi bi-pencil-square"></i> Tạo đơn xin nghỉ</a></li>
                <li class="nav-item"><a href="/lich-su-nghi" class="nav-link"><i class="bi bi-clock-history"></i> Lịch sử đơn từ</a></li>
                <% if (user.ma_chuc_vu === 1 || user.ma_chuc_vu === 2) { %>
                    <h6 class="sidebar-heading px-4 mt-4 mb-2 text-muted small fw-bold">QUẢN TRỊ VIÊN</h6>
                    <li class="nav-item"><a href="/duyet-don" class="nav-link"><i class="bi bi-check2-square"></i> Duyệt đơn</a></li>
                    <li class="nav-item"><a href="/quan-ly-nhan-su" class="nav-link"><i class="bi bi-people-fill"></i> Hồ sơ Nhân sự</a></li>
                <% } %>
            </ul>
            <div class="sidebar-footer">
                <a href="/dang-xuat" class="btn btn-light w-100 fw-semibold text-danger" style="border-radius: 12px;"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
            </div>
        </nav>

        <div id="content">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <div>
                    <h2 class="fw-bold mb-1" style="letter-spacing: -1px;">Thu nhập Cá nhân</h2>
                    <p class="text-muted mb-0">Báo cáo chi tiết kỳ lương Tháng <%= chiTietLuong.thang %></p>
                </div>
                <button class="btn btn-dark rounded-pill shadow-sm fw-semibold px-4 py-2" onclick="window.print()">
                    <i class="bi bi-download me-2"></i>Tải bản PDF
                </button>
            </div>

            <div class="payslip-container">
                
                <div class="d-flex justify-content-between align-items-start border-bottom pb-5 mb-5" style="border-color: #f0f0f5 !important;">
                    <div class="d-flex align-items-center">
                        <div class="brand-logo me-4 shadow-sm"><i class="bi bi-buildings-fill"></i></div>
                        <div>
                            <h3 class="fw-bold text-dark mb-1" style="letter-spacing: -1px;">Phiếu thanh toán Lương</h3>
                            <div class="text-muted fw-medium">Công ty TNHH Công nghệ Present</div>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold mb-2">
                            Kỳ lương: Tháng <%= chiTietLuong.thang %> / <%= chiTietLuong.nam %>
                        </div>
                        <div class="text-muted small">Ngày xuất: <%= new Date().toLocaleDateString('vi-VN') %></div>
                    </div>
                </div>

                <div class="row mb-5 pb-4 border-bottom" style="border-color: #f0f0f5 !important;">
                    <div class="col-md-4">
                        <div class="info-label">Nhân sự</div>
                        <div class="info-value"><%= user.ho_ten %></div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-label">Chức danh / Phòng ban</div>
                        <div class="info-value"><%= user.phong_ban %></div>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <div class="info-label">Liên hệ</div>
                        <div class="info-value"><%= user.email %></div>
                    </div>
                </div>

                <div class="row g-5">
                    <div class="col-md-6">
                        <div class="section-title text-dark">
                            <i class="bi bi-arrow-down-circle-fill text-success opacity-75"></i> Các khoản Thu nhập
                        </div>
                        <div class="pe-md-3">
                            <div class="amount-row">
                                <span class="amount-label">Lương cơ bản (Gross)</span>
                                <span class="amount-value text-dark"><%= chiTietLuong.luongCoBan.toLocaleString('vi-VN') %> đ</span>
                            </div>
                            <div class="amount-row">
                                <span class="amount-label">Phụ cấp (Ăn trưa, xăng xe)</span>
                                <span class="amount-value text-dark"><%= chiTietLuong.phuCap.toLocaleString('vi-VN') %> đ</span>
                            </div>
                            <div class="amount-row">
                                <span class="amount-label">Làm thêm ngoài giờ (OT)</span>
                                <span class="amount-value text-dark"><%= chiTietLuong.tienOT.toLocaleString('vi-VN') %> đ</span>
                            </div>
                            <div class="amount-row">
                                <span class="amount-label">Thưởng / Bonus</span>
                                <span class="amount-value text-dark"><%= chiTietLuong.thuong.toLocaleString('vi-VN') %> đ</span>
                            </div>
                            <div class="amount-row mt-3 pt-4" style="border-top: 2px solid #1d1d1f; border-bottom: none;">
                                <span class="fw-bold text-dark text-uppercase" style="font-size: 0.9rem; letter-spacing: 1px;">Tổng Thu Nhập</span>
                                <span class="fw-bold text-dark fs-5"><%= chiTietLuong.tongThuNhap.toLocaleString('vi-VN') %> đ</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="section-title text-dark">
                            <i class="bi bi-arrow-up-circle-fill text-danger opacity-75"></i> Các khoản Khấu trừ
                        </div>
                        <div class="ps-md-3">
                            <div class="amount-row">
                                <span class="amount-label">Nghỉ Việc riêng (<%= chiTietLuong.soNgayBiTru %> ngày)</span>
                                <span class="amount-value text-danger">- <%= chiTietLuong.truNghiViecRieng.toLocaleString('vi-VN') %> đ</span>
                            </div>
                            <div class="amount-row">
                                <span class="amount-label">BHXH, BHYT, BHTN (10.5%)</span>
                                <span class="amount-value text-danger">- <%= chiTietLuong.baoHiem.toLocaleString('vi-VN') %> đ</span>
                            </div>
                            <div class="amount-row">
                                <span class="amount-label">Thuế thu nhập cá nhân</span>
                                <span class="amount-value text-muted">Được miễn giảm</span>
                            </div>
                            <div class="amount-row mt-3 pt-4" style="border-top: 2px solid #1d1d1f; border-bottom: none;">
                                <span class="fw-bold text-dark text-uppercase" style="font-size: 0.9rem; letter-spacing: 1px;">Tổng Khấu Trừ</span>
                                <span class="fw-bold text-danger fs-5">- <%= chiTietLuong.tongKhauTru.toLocaleString('vi-VN') %> đ</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="premium-net-box d-flex flex-column flex-md-row justify-content-between align-items-center">
                    <div class="mb-3 mb-md-0 position-relative" style="z-index: 2;">
                        <h4 class="fw-bold text-white mb-1">Lương Thực Nhận (NET)</h4>
                        <div class="text-white opacity-75" style="font-size: 0.95rem;">Đã bao gồm thanh toán phụ cấp và trừ bảo hiểm</div>
                    </div>
                    <div class="text-end position-relative" style="z-index: 2;">
                        <div class="net-amount">
                            <%= chiTietLuong.thucLanh.toLocaleString('vi-VN') %><span class="currency">VNĐ</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>