<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Duyệt đơn - Present Portal</title>
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        /* FONT CHỮ CHUẨN APPLE & MÀU NỀN */
        body {
            background-color: #f5f5f7; 
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            color: #1d1d1f;
            overflow-x: hidden;
        }
        
        .text-orange { color: #f26522 !important; }
        .bg-orange { background-color: #f26522 !important; color: white; }
        .btn-orange { background-color: #f26522; color: white; border: none; font-weight: 600; padding: 10px 20px; border-radius: 12px; transition: 0.3s; }
        .btn-orange:hover { background-color: #d9531e; color: white; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(242, 101, 34, 0.3); }

        .wrapper { display: flex; width: 100%; align-items: stretch; }
        
        /* Sidebar */
        #sidebar {
            min-width: 260px;
            max-width: 260px;
            background: #ffffff;
            min-height: 100vh;
            border-right: 1px solid rgba(0,0,0,0.05);
            display: flex;
            flex-direction: column;
            position: fixed;
            box-shadow: 2px 0 20px rgba(0,0,0,0.02);
            z-index: 10;
        }
        .sidebar-header { padding: 30px 24px; }
        
        .nav-link { color: #515154; padding: 12px 20px; font-weight: 500; border-radius: 12px; margin: 4px 16px; transition: all 0.2s; font-size: 0.95rem;}
        .nav-link i { margin-right: 12px; font-size: 1.2rem; vertical-align: text-bottom;}
        .nav-link:hover { background: #fff3ed; color: #f26522; }
        .nav-link.active { background: #f26522; color: #ffffff; box-shadow: 0 4px 10px rgba(242, 101, 34, 0.25); }

        .sidebar-footer { margin-top: auto; padding: 24px; border-top: 1px solid rgba(0,0,0,0.05); }
        
        #content { width: calc(100% - 260px); margin-left: 260px; padding: 40px 50px; }
        
        /* Card chứa bảng (Apple Glassmorphism) */
        .content-card {
            background: #ffffff;
            border-radius: 20px;
            border: 1px solid rgba(0,0,0,0.04);
            box-shadow: 0 4px 24px rgba(0,0,0,0.04);
            overflow: hidden;
        }

        /* Tùy chỉnh bảng table */
        .table-custom { --bs-table-bg: transparent; margin-bottom: 0; }
        .table-custom thead th { border-bottom: 1px solid rgba(0,0,0,0.05); color: #86868b; font-size: 0.8rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px; padding: 15px 20px;}
        .table-custom tbody td { border-bottom: 1px solid rgba(0,0,0,0.03); padding: 20px; vertical-align: middle;}
        .table-custom tbody tr:hover { background-color: #fafafc; }
        .table-custom tbody tr:last-child td { border-bottom: none; }
    </style>
</head>
<body>

    <div class="wrapper">
        <!-- SIDEBAR -->
        <nav id="sidebar">
            <div class="sidebar-header d-flex align-items-center mb-2">
                <div class="bg-orange rounded-3 p-2 me-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px;">
                    <i class="bi bi-buildings text-white fs-5"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold text-dark" style="letter-spacing: -0.5px;">Present</h5>
                    <small class="text-muted fw-medium" style="font-size: 0.8rem;">Hệ thống Nhân sự</small>
                </div>
            </div>

            <ul class="nav flex-column mt-2">
                <li class="nav-item">
                    <a href="/dashboard" class="nav-link"><i class="bi bi-grid-1x2-fill"></i> Tổng quan</a>
                </li>
                
                <h6 class="sidebar-heading px-4 mt-4 mb-2 text-muted small fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">QUẢN LÝ ĐƠN TỪ</h6>
                <li class="nav-item">
                    <a href="/tao-don" class="nav-link"><i class="bi bi-pencil-square"></i> Tạo đơn xin nghỉ</a>
                </li>
                <li class="nav-item">
                    <a href="/lich-su-nghi" class="nav-link"><i class="bi bi-clock-history"></i> Lịch sử đơn từ</a>
                </li>
                 <li class="nav-item"><a href="/bang_luong" class="nav-link "><i class="bi bi-cash-stack"></i> Phiếu lương</a></li>

                <!-- Phân quyền Quản trị -->
                <% if (user.ma_chuc_vu === 1 || user.ma_chuc_vu === 2) { %>
                    <h6 class="sidebar-heading px-4 mt-4 mb-2 text-muted small fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">QUẢN TRỊ VIÊN</h6>
                    <!-- Đánh dấu Active ở trang Duyệt đơn -->
                   
                    <li class="nav-item">
                        <a href="/duyet-don" class="nav-link active"><i class="bi bi-check2-square"></i> Duyệt đơn 
                                <li class="nav-item"><a href="/quan-ly-nhan-su" class="nav-link "><i class="bi bi-people-fill"></i> Hồ sơ Nhân sự</a></li>
                            <% if (danhSachDon.length > 0) { %>
                                <span class="badge bg-white text-orange ms-2 rounded-pill"><%= danhSachDon.length %></span>
                            <% } %>
                        </a>
                    </li>
                <% } %>
            </ul>

            <div class="sidebar-footer">
                <div class="d-flex align-items-center mb-4 px-2">
                    <img src="https://ui-avatars.com/api/?name=<%= user.ho_ten %>&background=f26522&color=fff&rounded=true" alt="Avatar" width="40" height="40" class="me-3 shadow-sm">
                    <div style="overflow: hidden;">
                        <h6 class="mb-0 fw-bold text-truncate" style="font-size: 0.9rem;"><%= user.ho_ten %></h6>
                        <small class="text-muted text-truncate d-block" style="font-size: 0.8rem;"><%= user.email %></small>
                    </div>
                </div>
                <a href="/dang-xuat" class="btn btn-light w-100 fw-semibold" style="color: #ff3b30; border-radius: 12px; background: #fff5f5;"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
            </div>
        </nav>

        <!-- MAIN CONTENT -->
        <div id="content">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <div>
                    <h2 class="fw-bold mb-1" style="letter-spacing: -1px;">Quản lý Phê duyệt</h2>
                    <p class="text-muted mb-0" style="font-size: 0.95rem;">Danh sách các đơn xin nghỉ phép đang chờ xử lý</p>
                </div>
            </div>

            <div class="content-card">
                <% if (danhSachDon.length === 0) { %>
                    <!-- Empty State: Giao diện khi không có đơn -->
                    <div class="text-center py-5">
                        <div class="d-inline-flex justify-content-center align-items-center bg-light rounded-circle mb-4 mt-3" style="width: 100px; height: 100px;">
                            <i class="bi bi-check2-all fs-1" style="color: #34c759;"></i>
                        </div>
                        <h5 class="fw-bold" style="color: #1d1d1f;">Tất cả đã được giải quyết!</h5>
                        <p class="text-muted mb-4">Hiện tại không có đơn xin nghỉ phép nào đang chờ bạn duyệt.</p>
                        <a href="/dashboard" class="btn btn-light border fw-semibold px-4 rounded-pill">Quay lại Bảng điều khiển</a>
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-custom align-middle">
                            <thead>
                                <tr>
                                    <th>Nhân viên</th>
                                    <th>Chi tiết nghỉ</th>
                                    <th>Thời gian</th>
                                    <th>Bàn giao cho</th>
                                    <th class="text-end">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% danhSachDon.forEach(function(don) { %>
                                    <tr>
                                        <!-- Cột 1: Thông tin nhân sự -->
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="https://ui-avatars.com/api/?name=<%= don.ho_ten %>&background=random&color=fff&rounded=true" alt="Avatar" width="42" height="42" class="me-3 shadow-sm">
                                                <div>
                                                    <div class="fw-bold" style="color: #1d1d1f; font-size: 0.95rem;"><%= don.ho_ten %></div>
                                                    <small class="text-muted"><%= don.email %></small>
                                                </div>
                                            </div>
                                        </td>
                                        
                                        <!-- Cột 2: Loại nghỉ & Lý do -->
                                        <td>
                                            <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-1 rounded-pill mb-2 border border-warning border-opacity-25" style="color: #d97706 !important;"><%= don.loai_nghi %></span>
                                            <div class="text-secondary" style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 0.85rem;" title="<%= don.ly_do %>">
                                                Lý do: <%= don.ly_do %>
                                            </div>
                                        </td>

                                        <!-- Cột 3: Thời gian -->
                                        <td>
                                            <div class="fw-semibold" style="color: #1d1d1f; font-size: 0.9rem;">Từ: <%= new Date(don.ngay_bat_dau).toLocaleDateString('vi-VN') %></div>
                                            <div class="fw-semibold text-muted" style="font-size: 0.9rem;">Đến: <%= new Date(don.ngay_ket_thuc).toLocaleDateString('vi-VN') %></div>
                                        </td>

                                        <!-- Cột 4: Bàn giao (Sếp có thể thay đổi) -->
                                        <td>
                                            <div class="d-flex align-items-center bg-light rounded-pill px-2 py-1 border" style="width: 200px;">
                                                <div class="bg-white text-orange rounded-circle d-flex justify-content-center align-items-center me-1 shadow-sm" style="min-width:24px; height:24px; font-size:12px;">
                                                    <i class="bi bi-shuffle"></i>
                                                </div>
                                                
                                                <!-- Dropdown chọn người, liên kết với nút bấm ở Cột 5 bằng form="..." -->
                                                <select class="form-select form-select-sm border-0 bg-transparent shadow-none fw-semibold text-secondary" style="cursor: pointer; font-size: 0.85rem;" name="nguoi_ban_giao_moi" form="form-duyet-<%= don.ma_don %>">
                                                    <% if (typeof danhSachNhanVien !== 'undefined') { %>
                                                        <% danhSachNhanVien.forEach(function(nv) { %>
                                                            <option value="<%= nv.ho_ten %>" <%= don.nguoi_ban_giao === nv.ho_ten ? 'selected' : '' %>>
                                                                <%= nv.ho_ten %>
                                                            </option>
                                                        <% }); %>
                                                    <% } %>
                                                </select>
                                            </div>
                                            <small class="text-muted d-block mt-1 ms-2" style="font-size: 0.7rem;"><i class="bi bi-pencil-fill me-1"></i>Sếp có thể đổi người</small>
                                        </td>

                                        <!-- Cột 5: Form Nút bấm -->
                                        <td>
                                            <div class="d-flex justify-content-end gap-2">
                                                <!-- Form Nút Duyệt: ID bắt buộc phải trùng khớp với form="..." ở Cột 4 -->
                                                <form id="form-duyet-<%= don.ma_don %>" action="/xu-ly-duyet-don" method="POST" style="margin: 0;">
                                                    <input type="hidden" name="ma_don" value="<%= don.ma_don %>">
                                                    <input type="hidden" name="ma_nhan_vien" value="<%= don.ma_nhan_vien %>">
                                                    <input type="hidden" name="ngay_bat_dau" value="<%= don.ngay_bat_dau %>">
                                                    <input type="hidden" name="ngay_ket_thuc" value="<%= don.ngay_ket_thuc %>">
                                                    <input type="hidden" name="trang_thai_moi" value="Đã duyệt">
                                                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 py-2 fw-semibold shadow-sm border-0 d-flex align-items-center">
                                                        <i class="bi bi-check-lg me-1 fs-6"></i> Duyệt
                                                    </button>
                                                </form>
                                                
                                                <!-- Form Nút Từ chối -->
                                                <form action="/xu-ly-duyet-don" method="POST" style="margin: 0;">
                                                    <input type="hidden" name="ma_don" value="<%= don.ma_don %>">
                                                    <input type="hidden" name="trang_thai_moi" value="Từ chối">
                                                    <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3 py-2 fw-semibold shadow-sm border-0 d-flex align-items-center" style="background-color: #ff3b30;">
                                                        <i class="bi bi-x-lg me-1 fs-6"></i> Từ chối
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>

        </div>
    </div>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>