<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Nhân sự - Present Portal</title>
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        /* Reset & premium fonts */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #e5e5ea; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #c1c1c4; }

        body {
            background-color: #faf9f5;
            font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            color: #1d1d1f;
            overflow-x: hidden;
        }

        .text-orange { color: #8c7b45 !important; }
        .bg-orange { background-color: #F3E6B3 !important; }
        
        .btn-orange {
            background: linear-gradient(135deg, #F3E6B3 0%, #e2d39d 100%);
            color: #3d3516;
            border: none;
            font-weight: 600;
            padding: 12px 24px;
            border-radius: 14px;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 4px 12px rgba(243, 230, 179, 0.3);
        }
        
        .btn-orange:hover {
            background: linear-gradient(135deg, #e2d39d 0%, #d1c18c 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(243, 230, 179, 0.5);
            color: #241f0b;
        }

        .wrapper { display: flex; width: 100%; align-items: stretch; }

        /* Premium Sidebar */
        #sidebar {
            min-width: 270px;
            max-width: 270px;
            background: #ffffff;
            min-height: 100vh;
            border-right: 1px solid rgba(0,0,0,0.04);
            display: flex;
            flex-direction: column;
            position: fixed;
            box-shadow: 4px 0 24px rgba(140, 123, 69, 0.02);
            z-index: 10;
        }
        
        .sidebar-header { padding: 32px 24px 20px 24px; }
        
        .nav-link {
            color: #515154;
            padding: 12px 20px;
            font-weight: 500;
            border-radius: 14px;
            margin: 4px 16px;
            transition: all 0.25s ease;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
        }
        
        .nav-link i { margin-right: 12px; font-size: 1.2rem; width: 24px; text-align: center; }
        .nav-link:hover { background: rgba(243, 230, 179, 0.12); color: #8c7b45; }
        
        .nav-link.active {
            background: linear-gradient(135deg, #F3E6B3 0%, #e2d39d 100%);
            color: #3d3516;
            box-shadow: 0 6px 15px rgba(243, 230, 179, 0.35);
            font-weight: 600;
        }
        
        .sidebar-heading {
            font-size: 0.7rem;
            letter-spacing: 0.8px;
            font-weight: 700;
            color: #9e9e9f;
            padding-left: 24px;
            margin-top: 24px;
            margin-bottom: 8px;
            text-transform: uppercase;
        }
        
        .sidebar-footer {
            margin-top: auto;
            padding: 24px;
            border-top: 1px solid rgba(0,0,0,0.04);
        }

        /* Main content styling */
        #content {
            width: calc(100% - 270px);
            margin-left: 270px;
            padding: 40px 50px;
        }

        /* Premium Card & Table */
        .premium-card {
            background: #ffffff;
            border-radius: 24px;
            border: 1px solid rgba(140, 123, 69, 0.04);
            box-shadow: 0 10px 30px rgba(140, 123, 69, 0.02);
            overflow: hidden;
        }
        
        .table-custom { margin-bottom: 0; }
        .table-custom thead th {
            border-bottom: 1px solid rgba(0,0,0,0.04);
            color: #86868b;
            font-size: 0.75rem;
            text-transform: uppercase;
            font-weight: 600;
            padding: 18px 24px;
            letter-spacing: 0.5px;
        }
        .table-custom tbody td {
            border-bottom: 1px solid rgba(0,0,0,0.02);
            padding: 18px 24px;
            vertical-align: middle;
        }
        .table-custom tbody tr:hover {
            background-color: rgba(243, 230, 179, 0.03);
        }
        .table-custom tbody tr:last-child td {
            border-bottom: none;
        }
        
        /* Badges */
        .badge-soft {
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 40px;
            font-size: 0.8rem;
            display: inline-flex;
            align-items: center;
        }
        
        .badge-soft-warning {
            background-color: #fff8eb;
            color: #b25e00;
            border: 1px solid rgba(255, 149, 0, 0.15);
        }
        
        .badge-soft-success {
            background-color: #f2fcf5;
            color: #1e7b3c;
            border: 1px solid rgba(52, 199, 89, 0.15);
        }

        .badge-soft-danger {
            background-color: #fdf2f2;
            color: #de350b;
            border: 1px solid rgba(222, 53, 11, 0.15);
        }
        
        .badge-soft-primary {
            background-color: #f0f5ff;
            color: #0052cc;
            border: 1px solid rgba(0, 82, 204, 0.15);
        }
        
        .badge-soft-secondary {
            background-color: #f4f5f7;
            color: #4a5568;
            border: 1px solid rgba(74, 85, 104, 0.15);
        }

        .badge-soft-champagne {
            background-color: #faf7eb;
            color: #8c7b45;
            border: 1px solid rgba(140, 123, 69, 0.18);
        }

        /* Form elements */
        .form-control, .form-select {
            border-radius: 12px;
            padding: 12px 16px;
            background-color: #fafafc;
            border: 1px solid #e5e5ea;
            color: #1d1d1f;
            font-weight: 500;
            transition: all 0.2s ease;
        }
        .form-control:focus, .form-select:focus {
            border-color: #F3E6B3;
            box-shadow: 0 0 0 4px rgba(243, 230, 179, 0.4);
            background-color: #ffffff;
            outline: none;
        }

        /* Modal styling */
        .modal-content-premium {
            background: #ffffff;
            border-radius: 28px;
            border: 1px solid rgba(140, 123, 69, 0.08);
            box-shadow: 0 24px 60px rgba(140, 123, 69, 0.15);
            overflow: hidden;
            padding: 10px;
        }

        @media (max-width: 992px) {
            #sidebar { transform: translateX(-100%); position: fixed; }
            #content { width: 100%; margin-left: 0; padding: 30px 20px; }
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <!-- SIDEBAR -->
        <nav id="sidebar">
            <div class="sidebar-header d-flex align-items-center mb-2">
                <div class="bg-orange rounded-3 p-2 me-3 shadow-sm" style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-buildings text-dark fs-5"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold" style="letter-spacing: -0.3px;">Present</h5>
                    <small class="text-muted fw-medium" style="font-size: 0.7rem;">Hệ thống Nhân sự</small>
                </div>
            </div>
            
            <ul class="nav flex-column mt-2">
                <li class="nav-item">
                    <a href="/dashboard" class="nav-link"><i class="bi bi-grid-1x2-fill"></i> Tổng quan</a>
                </li>
                
                <div class="sidebar-heading">CÁ NHÂN</div>
                <li class="nav-item">
                    <a href="/bang-luong" class="nav-link"><i class="bi bi-cash-stack"></i> Phiếu lương</a>
                </li>
                
                <div class="sidebar-heading">QUẢN LÝ ĐƠN TỪ</div>
                <li class="nav-item">
                    <a href="/tao-don" class="nav-link"><i class="bi bi-pencil-square"></i> Tạo đơn xin nghỉ</a>
                </li>
                <li class="nav-item">
                    <a href="/lich-su-nghi" class="nav-link"><i class="bi bi-clock-history"></i> Lịch sử đơn từ</a>
                </li>

                <% if (user.ma_chuc_vu === 1 || user.ma_chuc_vu === 2) { %>
                    <div class="sidebar-heading">QUẢN TRỊ VIÊN</div>
                    <li class="nav-item">
                        <a href="/duyet-don" class="nav-link"><i class="bi bi-check2-square"></i> Duyệt đơn
                            <% if (typeof soDonChoDuyet !== 'undefined' && soDonChoDuyet > 0) { %>
                                <span class="badge bg-danger ms-2 rounded-pill"><%= soDonChoDuyet %></span>
                            <% } %>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/quan-ly-nhan-su" class="nav-link active"><i class="bi bi-people-fill"></i> Hồ sơ Nhân sự</a>
                    </li>
                <% } %>
            </ul>
            
            <div class="sidebar-footer">
                <div class="d-flex align-items-center mb-3 px-2">
                    <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.ho_ten) %>&background=F3E6B3&color=1d1d1f&bold=true&rounded=true&size=42" width="42" height="42" class="me-3 shadow-sm rounded-circle">
                    <div>
                        <h6 class="mb-0 fw-bold"><%= user.ho_ten %></h6>
                        <small class="text-muted d-block text-truncate" style="max-width: 150px; font-size: 0.8rem;"><%= user.email %></small>
                    </div>
                </div>
                <a href="/dang-xuat" class="btn btn-light w-100 fw-semibold" style="color: #ff3b30; border-radius: 14px; background: #fff5f5; border: none; padding: 10px;"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
            </div>
        </nav>

        <!-- MAIN CONTENT -->
        <div id="content">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-5">
                <div>
                    <h2 class="fw-bold mb-1" style="letter-spacing: -1px;">Hồ sơ Nhân sự</h2>
                    <p class="text-muted mb-0">Quản lý thông tin, phòng ban và mức lương của toàn bộ nhân viên</p>
                </div>
                <!-- Nút bật Popup Thêm Nhân Viên -->
                <button class="btn btn-orange shadow-sm mt-3 mt-sm-0" data-bs-toggle="modal" data-bs-target="#modalThemNV">
                    <i class="bi bi-person-plus-fill me-2"></i>Thêm nhân viên
                </button>
            </div>

            <div class="premium-card">
                <div class="table-responsive">
                    <table class="table table-custom align-middle">
                        <thead>
                            <tr>
                                <th>Nhân viên</th>
                                <th>Phòng ban</th>
                                <th>Liên hệ</th>
                                <th>Lương cơ bản</th>
                                <th class="text-end">Phân quyền</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% danhSachNV.forEach(function(nv) { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(nv.ho_ten) %>&background=F3E6B3&color=1d1d1f&bold=true&rounded=true" width="42" height="42" class="me-3 shadow-sm">
                                            <div>
                                                <div class="fw-bold text-dark"><%= nv.ho_ten %></div>
                                                <small class="text-muted"><%= nv.email %></small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge-soft badge-soft-champagne">
                                            <i class="bi bi-person-workspace me-1.5"></i><%= nv.phong_ban %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="text-dark fw-medium" style="font-size: 0.9rem;">
                                            <i class="bi bi-telephone text-muted me-1.5"></i><%= nv.so_dien_thoai || 'Chưa cập nhật' %>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">
                                            <%= nv.luong_co_ban.toLocaleString('vi-VN') %> <span class="text-muted fw-normal" style="font-size: 0.8rem;">đ</span>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <% if (nv.ma_chuc_vu === 1) { %>
                                            <span class="badge-soft badge-soft-danger">Sếp (Manager)</span>
                                        <% } else if (nv.ma_chuc_vu === 2) { %>
                                            <span class="badge-soft badge-soft-primary">Quản trị (HR)</span>
                                        <% } else { %>
                                            <span class="badge-soft badge-soft-secondary">Nhân viên</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- POPUP (MODAL) THÊM NHÂN VIÊN MỚI -->
    <div class="modal fade" id="modalThemNV" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content modal-content-premium">
                <div class="modal-header border-0 px-4 pt-4 pb-0">
                    <h4 class="fw-bold text-dark mb-0" style="letter-spacing: -0.5px;">Thêm nhân sự mới</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form action="/them-nhan-vien" method="POST">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Họ và tên *</label>
                                <input type="text" class="form-control" name="ho_ten" placeholder="Nguyễn Văn A" required>
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Email đăng nhập *</label>
                                <input type="email" class="form-control" name="email" placeholder="example@present.com" required>
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Mật khẩu mặc định *</label>
                                <input type="text" class="form-control" name="mat_khau" value="123456" required>
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Số điện thoại</label>
                                <input type="text" class="form-control" name="so_dien_thoai" placeholder="0901234567">
                            </div>
                        </div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label class="small fw-bold text-muted mb-1">Vị trí / Chuyên môn</label>
                                <select class="form-select" name="phong_ban">
                                    <option value="Fullstack Developer">Fullstack Developer</option>
                                    <option value="Business Analyst (BA)">Business Analyst - BA</option>
                                    <option value="UI-UX Designer">UI-UX Designer</option>
                                    <option value="Software Developer">Software Developer</option>
                                    <option value="Data Analyst (DA)">Data Analyst - DA</option>
                                    <option value="Tester">Tester / QA</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="small fw-bold text-muted mb-1">Lương cơ bản (VNĐ) *</label>
                                <input type="number" class="form-control" name="luong_co_ban" value="5000000" required>
                            </div>
                            <div class="col-md-4">
                                <label class="small fw-bold text-muted mb-1">Cấp bậc (Phân quyền) *</label>
                                <select class="form-select" name="ma_chuc_vu">
                                    <option value="3">3 - Nhân viên</option>
                                    <option value="2">2 - HR/Admin</option>
                                    <option value="1">1 - Sếp/Manager</option>
                                </select>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2 border-top pt-3" style="border-color: #f0f0f5 !important;">
                            <button type="button" class="btn btn-light px-4 py-2" data-bs-dismiss="modal" style="border-radius: 12px; font-weight: 600;">Hủy bỏ</button>
                            <button type="submit" class="btn btn-orange px-4 py-2">Lưu nhân sự</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>