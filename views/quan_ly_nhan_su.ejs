<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Nhân sự - Present Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f5f5f7; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif; color: #1d1d1f; overflow-x: hidden; }
        .text-orange { color: #f26522 !important; }
        .bg-orange { background-color: #f26522 !important; color: white; }
        .btn-orange { background-color: #f26522; color: white; border: none; font-weight: 600; padding: 10px 20px; border-radius: 12px; transition: 0.3s; }
        .btn-orange:hover { background-color: #d9531e; color: white; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(242, 101, 34, 0.3); }
        .wrapper { display: flex; width: 100%; align-items: stretch; }
        #sidebar { min-width: 260px; max-width: 260px; background: #ffffff; min-height: 100vh; border-right: 1px solid rgba(0,0,0,0.05); display: flex; flex-direction: column; position: fixed; z-index: 10; }
        .sidebar-header { padding: 30px 24px; }
        .nav-link { color: #515154; padding: 12px 20px; font-weight: 500; border-radius: 12px; margin: 4px 16px; transition: all 0.2s; font-size: 0.95rem;}
        .nav-link i { margin-right: 12px; font-size: 1.2rem; vertical-align: text-bottom;}
        .nav-link:hover, .nav-link.active { background: #fff3ed; color: #f26522; }
        .nav-link.active { background: #f26522; color: #ffffff; box-shadow: 0 4px 10px rgba(242, 101, 34, 0.25); }
        .sidebar-footer { margin-top: auto; padding: 24px; border-top: 1px solid rgba(0,0,0,0.05); }
        #content { width: calc(100% - 260px); margin-left: 260px; padding: 40px 50px; }
        .content-card { background: #ffffff; border-radius: 20px; border: 1px solid rgba(0,0,0,0.04); box-shadow: 0 4px 24px rgba(0,0,0,0.04); overflow: hidden; }
        .table-custom { margin-bottom: 0; }
        .table-custom thead th { border-bottom: 1px solid rgba(0,0,0,0.05); color: #86868b; font-size: 0.8rem; text-transform: uppercase; font-weight: 600; padding: 15px 20px;}
        .table-custom tbody td { border-bottom: 1px solid rgba(0,0,0,0.03); padding: 15px 20px; vertical-align: middle;}
        .form-control, .form-select { border-radius: 12px; padding: 12px 16px; background-color: #fafafc; border: 1px solid #e5e5ea; }
        .form-control:focus, .form-select:focus { border-color: #f26522; box-shadow: 0 0 0 4px rgba(242, 101, 34, 0.15); background-color: #ffffff; }
    </style>
</head>
<body>
    <div class="wrapper">
        <!-- SIDEBAR -->
        <nav id="sidebar">
            <div class="sidebar-header d-flex align-items-center mb-2">
                <div class="bg-orange rounded-3 p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <i class="bi bi-buildings text-white fs-5"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold text-dark">Present</h5>
                    <small class="text-muted fw-medium">Hệ thống Nhân sự</small>
                </div>
            </div>
            <ul class="nav flex-column mt-2">
                <li class="nav-item">
                    <a href="/dashboard" class="nav-link"><i class="bi bi-grid-1x2-fill"></i> Tổng quan</a>
                </li>
                
                <h6 class="sidebar-heading px-4 mt-4 mb-2 text-muted small fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">CÁ NHÂN</h6>
                <li class="nav-item">
                    <a href="/bang-luong" class="nav-link"><i class="bi bi-cash-stack"></i> Phiếu lương</a>
                </li>

                <h6 class="sidebar-heading px-4 mt-4 mb-2 text-muted small fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">QUẢN LÝ ĐƠN TỪ</h6>
                <li class="nav-item">
                    <a href="/tao-don" class="nav-link"><i class="bi bi-pencil-square"></i> Tạo đơn xin nghỉ</a>
                </li>
                <li class="nav-item">
                    <a href="/lich-su-nghi" class="nav-link "><i class="bi bi-clock-history"></i> Lịch sử đơn từ</a>
                </li>

                <% if (user.ma_chuc_vu === 1 || user.ma_chuc_vu === 2) { %>
                    <h6 class="sidebar-heading px-4 mt-4 mb-2 text-muted small fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">QUẢN TRỊ VIÊN</h6>
                    <li class="nav-item">
                        <a href="/duyet-don" class="nav-link"><i class="bi bi-check2-square"></i> Duyệt đơn</a>
                    </li>
                    <li class="nav-item">
                        <a href="/quan-ly-nhan-su" class="nav-link active"><i class="bi bi-people-fill"></i> Hồ sơ Nhân sự</a>
                    </li>
                <% } %>
            </ul>
            <div class="sidebar-footer">
                <a href="/dang-xuat" class="btn btn-light w-100 fw-semibold text-danger" style="border-radius: 12px;"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
            </div>
        </nav>

        <!-- MAIN CONTENT -->
        <div id="content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Hồ sơ Nhân sự</h2>
                    <p class="text-muted mb-0">Quản lý thông tin, phòng ban và mức lương của toàn bộ nhân viên</p>
                </div>
                <!-- Nút bật Popup Thêm Nhân Viên -->
                <button class="btn btn-orange shadow-sm" data-bs-toggle="modal" data-bs-target="#modalThemNV"><i class="bi bi-person-plus-fill me-2"></i>Thêm nhân viên</button>
            </div>

            <div class="content-card">
                <div class="table-responsive">
                    <table class="table table-custom align-middle">
                        <thead>
                            <tr>
                                <th>Nhân viên</th>
                                <th>Phòng ban</th>
                                <th>Liên hệ</th>
                                <th>Lương cơ bản</th>
                                <th class="text-end">Phân quyền</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% danhSachNV.forEach(function(nv) { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="https://ui-avatars.com/api/?name=<%= nv.ho_ten %>&background=random&color=fff&rounded=true" width="42" height="42" class="me-3">
                                            <div>
                                                <div class="fw-bold text-dark"><%= nv.ho_ten %></div>
                                                <small class="text-muted"><%= nv.email %></small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border px-2 py-1"><i class="bi bi-diagram-3 me-1 text-orange"></i> <%= nv.phong_ban %></span></td>
                                    <td><small class="fw-medium text-secondary"><i class="bi bi-telephone-fill me-1"></i> <%= nv.so_dien_thoai %></small></td>
                                    <td><div class="fw-bold text-success"><%= nv.luong_co_ban.toLocaleString('vi-VN') %>đ</div></td>
                                    <td class="text-end">
                                        <% if (nv.ma_chuc_vu === 1) { %>
                                            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-1 rounded-pill">Sếp (Manager)</span>
                                        <% } else if (nv.ma_chuc_vu === 2) { %>
                                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill">Quản trị (HR)</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-1 rounded-pill">Nhân viên</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- POPUP (MODAL) THÊM NHÂN VIÊN MỚI -->
    <div class="modal fade" id="modalThemNV" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" style="border-radius: 20px; border: none;">
                <div class="modal-header border-0 px-4 pt-4 pb-0">
                    <h5 class="fw-bold text-dark">Thêm nhân sự mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <form action="/them-nhan-vien" method="POST">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Họ và tên *</label>
                                <input type="text" class="form-control" name="ho_ten" required>
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Email đăng nhập *</label>
                                <input type="email" class="form-control" name="email" required>
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Mật khẩu mặc định *</label>
                                <input type="text" class="form-control" name="mat_khau" value="123456" required>
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Số điện thoại</label>
                                <input type="text" class="form-control" name="so_dien_thoai">
                            </div>
                        </div>
                        <div class="row g-3 mb-4">
                            <<div class="col-md-4">
                                <label class="small fw-bold text-muted mb-1">Vị trí / Chuyên môn</label>
                                <select class="form-select" name="phong_ban">
                                    <option value="Fullstack Developer">Fullstack Developer</option>
                                    <option value="Business Analyst (BA)">Business Analyst - BA </option>
                                    <option value="UI-UX Designer">UI-UX Designer </option>
                                    <option value="Software Developer">Software Developer</option>
                                    <option value="Data Analyst (DA)">Data Analyst - DA</option>
                                    <option value="Tester">Tester / QA</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="small fw-bold text-muted mb-1">Lương cơ bản (VNĐ) *</label>
                                <input type="number" class="form-control" name="luong_co_ban" value="5000000" required>
                            </div>
                            <div class="col-md-4">
                                <label class="small fw-bold text-muted mb-1">Cấp bậc (Phân quyền) *</label>
                                <select class="form-select" name="ma_chuc_vu">
                                    <option value="3">3 - Nhân viên</option>
                                    <option value="2">2 - HR/Admin</option>
                                    <option value="1">1 - Sếp/Manager</option>
                                </select>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius: 10px;">Hủy bỏ</button>
                            <button type="submit" class="btn btn-orange" style="border-radius: 10px;">Lưu nhân sự</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>